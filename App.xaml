<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:InstaPostGenerator"
             xmlns:converters="clr-namespace:InstaPostGenerator.Converters"
             x:Class="InstaPostGenerator.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToImageConverter x:Key="BoolToImageConverter" />
            <converters:GeneratingTextConverter x:Key="GeneratingTextConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:BoolToRadioFillConverter x:Key="BoolToRadioFillConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>