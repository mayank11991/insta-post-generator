<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InstaPostGenerator.ViewModels"
             xmlns:models="clr-namespace:InstaPostGenerator.Models"
             x:Class="InstaPostGenerator.Views.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="360Buzz"
             BackgroundColor="#000000">

    <ContentPage.BindingContext>
        <vm:MainPageViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Header -->
            <Frame BackgroundColor="#111111"
                   BorderColor="#FC5A11"
                   CornerRadius="16"
                   Padding="20"
                   HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="⚡ 360BUZZ"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#BEFA05"
                           HorizontalOptions="Center" />
                    <Label Text="Bollywood + Politics | Generate Reels &amp; Posts"
                           FontSize="13"
                           TextColor="#888"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Mode Selection -->
            <Frame BackgroundColor="#111111"
                   BorderColor="#333"
                   CornerRadius="12"
                   Padding="12"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="MODE"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#FC5A11"
                           FontFamily="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Frame BackgroundColor="{Binding IsPostMode, Converter={StaticResource BoolToColorConverter}, ConverterParameter=selected}"
                               BorderColor="{Binding IsPostMode, Converter={StaticResource BoolToColorConverter}, ConverterParameter=border}"
                               CornerRadius="10"
                               Padding="14"
                               HasShadow="False"
                               Grid.Column="0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetPostModeCommand}" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="📝" FontSize="28" HorizontalOptions="Center" />
                                <Label Text="Posts" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPostMode}" Value="True">
                                            <Setter Property="TextColor" Value="#BEFA05" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPostMode}" Value="False">
                                            <Setter Property="TextColor" Value="#888" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame BackgroundColor="{Binding IsPostMode, Converter={StaticResource InverseBoolConverter}, ConverterParameter=selected}"
                               BorderColor="{Binding IsPostMode, Converter={StaticResource InverseBoolConverter}, ConverterParameter=border}"
                               CornerRadius="10"
                               Padding="14"
                               HasShadow="False"
                               Grid.Column="1">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetReelModeCommand}" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="🎬" FontSize="28" HorizontalOptions="Center" />
                                <Label Text="Reels" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPostMode}" Value="False">
                                            <Setter Property="TextColor" Value="#BEFA05" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPostMode}" Value="True">
                                            <Setter Property="TextColor" Value="#888" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Category Selection -->
            <Frame BackgroundColor="#111111"
                   BorderColor="#333"
                   CornerRadius="12"
                   Padding="12"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="TOPICS"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#FC5A11" />
                    <Label Text="Tap to select | Random topics picked each run"
                           FontSize="11"
                           TextColor="#666" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategorySelection">
                                <Frame
                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=selected}"
                                    BorderColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=border}"
                                    CornerRadius="8"
                                    Padding="10"
                                    HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleCategoryCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="32,*">
                                        <Label Text="{Binding Emoji}"
                                               FontSize="18"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Grid.Column="0" />
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="14"
                                               VerticalOptions="Center"
                                               Grid.Column="1">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="Black" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Progress Bar -->
            <ProgressBar Progress="{Binding GenerateProgress}"
                         ProgressColor="#BEFA05"
                         BackgroundColor="#1A1A1A"
                         HeightRequest="4"
                         IsVisible="{Binding IsGenerating}" />

            <!-- Generate Button -->
            <Button Text="{Binding GenerateButtonText}"
                    Command="{Binding GenerateCommand}"
                    IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#BEFA05"
                    TextColor="#000000"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    HorizontalOptions="Fill" />

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   FontSize="13"
                   TextColor="#FC5A11"
                   HorizontalOptions="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- Post Carousel Button -->
            <Button Text="📱 Post Selected as Carousel"
                    Command="{Binding PostCarouselCommand}"
                    IsEnabled="{Binding CanPostCarousel}"
                    BackgroundColor="#FC5A11"
                    TextColor="#FFFFFF"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="48"
                    HorizontalOptions="Fill"
                    IsVisible="{Binding CanPostCarousel}" />

            <!-- Posts List -->
            <Label Text="GENERATED CONTENT"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#BEFA05"
                   IsVisible="{Binding Posts.Count, Converter={StaticResource IntToBoolConverter}}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Posts}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PostItemViewModel">
                        <Frame BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=selected_bg}"
                               BorderColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=border}"
                               CornerRadius="12"
                               Padding="14"
                               HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TogglePostSelectionCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Color="#BEFA05"
                                              HorizontalOptions="Start"
                                              VerticalOptions="Center" />
                                    <Label Text="{Binding DisplayTitle}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#BEFA05"
                                           LineBreakMode="WordWrap"
                                           HorizontalOptions="FillAndExpand" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding CategoryDisplay}" FontSize="11" TextColor="#FC5A11" />
                                    <Label Text="{Binding SourceDisplay}" FontSize="11" TextColor="#888" />
                                </HorizontalStackLayout>

                                <Label Text="{Binding CaptionPreview}"
                                       FontSize="12"
                                       TextColor="#CCC"
                                       LineBreakMode="WordWrap"
                                       MaxLines="3" />

                                <Label Text="{Binding HashtagsDisplay}"
                                       FontSize="11"
                                       TextColor="#FC5A11"
                                       LineBreakMode="WordWrap" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Text="{Binding CopyButtonText}"
                                            Command="{Binding CopyCommand}"
                                            BackgroundColor="#1A1A1A"
                                            TextColor="#BEFA05"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="36"
                                            Grid.Column="0" />
                                    <Button Text="{Binding PostButtonText}"
                                            Command="{Binding PostCommand}"
                                            BackgroundColor="#FC5A11"
                                            TextColor="#FFFFFF"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="36"
                                            Grid.Column="1" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Empty State -->
            <VerticalStackLayout
                IsVisible="{Binding Posts.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=inverse}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,40">
                <Label Text="⚡" FontSize="48" HorizontalOptions="Center" />
                <Label Text="No content yet" FontSize="18" TextColor="#666" HorizontalOptions="Center" />
                <Label Text="Select topics and hit Generate" FontSize="13" TextColor="#888" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
